    "from xgboost import XGBClassifier\n",
    "from skopt.space import Integer, Real\n",
    "\n",
    "param_space = {\n",
    "    'n_estimators': Integer(50, 500),  # 迭代次数\n",
    "    'max_depth': Integer(1, 10),  # 树的最大深度\n",
    "    'subsample': Real(0.5, 1.0),  # 子采样比例\n",
    "    'colsample_bytree': Real(0.5, 1.0),  # 列采样比例\n",
    "    'learning_rate': Real(0.01, 0.3),  # 学习率\n",
    "    'gamma': Real(0, 10),  # 惩罚项中叶子结点个数前的参数\n",
    "    'min_child_weight': Real(0, 10),  # 叶子节点最小权重\n",
    "    'reg_alpha': Real(0, 1),  # L1正则化项的参数\n",
    "    'reg_lambda': Real(1, 10),  # L2正则化项的参数\n",
    "    'scale_pos_weight': Real(1, 10)  # 类别不平衡时的权重调整\n",
    "}\n",
    "\n",
    "# 初始化XGBoost分类器\n",
    "model = XGBClassifier(device='gpu', eval_metric='auc')\n",
    "serach_utils.search_params(param_space, model, X_train, Y_train)"
   ]
