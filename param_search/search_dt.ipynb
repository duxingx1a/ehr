    "from sklearn.tree import DecisionTreeClassifier\n",
    "from skopt.space import Integer, Real\n",
    "\n",
    "param_space_decisionTree = {\n",
    "    'criterion': ['gini', 'entropy'],  # 分裂标准\n",
    "    'max_depth': Integer(3, 20),  # 最大深度\n",
    "    'min_samples_split': Integer(2, 10),  # 内部节点再划分所需最小样本数\n",
    "    'min_samples_leaf': Integer(1, 5)  # 叶子节点最少样本数\n",
    "}\n",
    "\n",
    "# 初始化DecisionTree分类器\n",
    "model = DecisionTreeClassifier()\n",
    "serach_utils.search_params(param_space_decisionTree, model, X_train, Y_train)"
